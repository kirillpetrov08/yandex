<?xml version="1.0" encoding="utf-8"?>
<!--
  Нативная реклама РСЯ.
  Обязательные элементы по правилам размещения:
   age (возрастная метка), sponsored (метка «реклама»), title (заголовок),
   icon/media (изображение), call_to_action (кнопка), feedback (обратная связь).
  Все они передаются в NativeAdViewBinder — тексты и ссылки заполняет SDK,
  менять их нельзя.
-->
<com.yandex.mobile.ads.nativeads.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#171B31"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/native_ad_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#B9BECB"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/native_ad_sponsored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="#B9BECB"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/native_ad_feedback"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/ad_icon_desc"
                android:src="@android:drawable/ic_menu_info_details" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/native_ad_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/ad_icon_desc"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/native_ad_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="#C7CCDA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/native_ad_domain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#8E94A6"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <com.yandex.mobile.ads.nativeads.MediaView
            android:id="@+id/native_ad_media"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <Button
            android:id="@+id/native_ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2FB37A"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</com.yandex.mobile.ads.nativeads.NativeAdView>
